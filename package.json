{
  "name": "statswatch-desktop",
  "productName": "StatsWatch Desktop",
  "version": "0.1.0",
  "description": "Overwatch companion for Windows: career stats lookup and automatic post-match review.",
  "author": "William Guo",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -b",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "ow-electron .",
    "test": "npm run build:main && node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js --sourcemap"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@overwolf/ow-electron": "^42.11.15",
    "@overwolf/ow-electron-builder": "^26.9.3",
    "@overwolf/ow-electron-packages-types": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "overwolf": {
    "packages": [
      "gep"
    ]
  }
}
