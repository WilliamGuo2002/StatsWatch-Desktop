{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    /* ow-electron replaces the electron package; there is no `electron` in
       node_modules, so point the type resolver at it. At runtime
       require('electron') is served by the ow-electron runtime itself. */
    "paths": {
      "electron": ["./node_modules/@overwolf/ow-electron"]
    },
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "sourceMap": true
  },
  "include": ["src/main", "src/shared"]
}
